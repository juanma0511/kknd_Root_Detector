    <string name="det_desc_su_binary">Checks for su binary in known root paths. HIGH requires SUID/exec or root-dir. LOW for known OEM stock stubs.</string>
    <string name="det_desc_root_apps">Magisk, KernelSU, APatch, SuperSU, LSPosed and 50+ known packages</string>
    <string name="det_desc_dangerous_props">Debuggable builds, unlocked verified boot, adb root and persistent root props</string>
    <string name="det_desc_tee_available">Checks if keys can be backed by a hardware TEE</string>
    <string name="det_desc_verified_boot_state">ro.boot.verifiedbootstate - green=locked/unmodified, orange=unlocked</string>
    <string name="det_desc_apk_sig">Signature recorded as baseline on first run</string>
    <string name="det_desc_keystore_backing">Reports the Android Keystore security level</string>
    <string name="det_desc_strongbox_feature">Checks if the device has a dedicated StrongBox security chip</string>
    <string name="det_desc_strongbox_key">Attempts to generate a key backed by StrongBox hardware</string>
    <string name="det_desc_verified_boot_key">ro.boot.vbmeta.digest and ro.boot.bootkey should not be unknown or all-zero on a healthy verified boot chain</string>
    <string name="det_desc_bootloader_state">ro.boot.flash.locked - 1=locked (secure), 0=unlocked</string>
    <string name="det_desc_dm_verity">ro.boot.veritymode - enforcing means system partition is verified</string>
    <string name="det_desc_encryption">ro.crypto.state should be 'encrypted' on all modern devices</string>
    <string name="det_desc_security_patch">Build.VERSION.SECURITY_PATCH - older than 12 months is a risk</string>
    <string name="det_desc_attestation">Generates an attested key and checks whether the returned chain exposes TEE or StrongBox attestation</string>

